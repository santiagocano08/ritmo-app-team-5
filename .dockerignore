# .dockerignore — keep the build context lean
# Mirrors .gitignore for things that must not enter the image.

.git/
.github/
.kiro/
.specify/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
__pycache__/
*.pyc
*.egg-info/

# Raw source data (large, not needed in container)
data/raw/

# Docs and specs (not needed in container)
docs/
specs/
contracts/
# Exception: the frontend image build type-checks mocks/tests that import the
# committed read-contract fixtures (dev-only; not shipped in the final stage).
!contracts/read/fixtures/
scripts/

# Env files (secrets must not enter images)
.env
.env.*

# Docker files themselves (no recursion needed)
Dockerfile*
docker-compose*.yml
compose*.yml

# Test files
tests/
src/data/tests/

# Frontend build artifacts and deps (the console image runs a fresh npm ci + build)
src/frontend/node_modules/
src/frontend/dist/
src/frontend/coverage/

# Logs
*.log
logs/
