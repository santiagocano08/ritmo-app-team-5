# .env.example — committed; copy to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
#
# PulsoFlota — Turn-1 environment variables
# All values here are safe, non-secret defaults for local development.
# In any real environment, replace POSTGRES_PASSWORD with a strong secret
# injected at runtime (Docker Secrets or Vault — deferred to turn 2).

# -- PostgreSQL credentials -------------------------------------------------
POSTGRES_DB=pulsoflota
POSTGRES_USER=pulsoflota
# REQUIRED. The compose stack refuses to start if this is not set.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# -- Application DSN (read by src/pulsoflota/config.py) ---------------------
# 'db' is the docker-compose service name; use 'localhost' for local runs.
DATABASE_URL=postgresql://pulsoflota:change_me@db:5432/pulsoflota

# -- API service port -------------------------------------------------------
API_PORT=8000

# -- Simulator settings (read by src/data/simulator/main.py) --------------------
SIM_SEED=42
SIM_DURATION_S=3600
# Wall-clock seconds per simulated 5-s step (1 = 5x faster than real time; 0 = as fast as possible)
SIM_PACE_S=1
# Planned headway in seconds (R14). Buses start this far apart; one bus cycle is
# (in-service buses x this value). Must equal config.corridor_settings.headway_planned_s.
SIM_PLANNED_HEADWAY_S=600

# -- Ingestion retry on a database outage (src/data/ingestion/retry.py) ------------
# Seconds to wait after the first failure; the wait doubles each attempt.
INGESTION_RETRY_INITIAL_S=1
# Cap of the wait between two attempts.
INGESTION_RETRY_MAX_WAIT_S=5
# Total retry window per outage; when it ends ingestion logs db_retry_exhausted and exits non-zero.
INGESTION_RETRY_TOTAL_S=120

# -- Ingestion freshness healthcheck (src/data/ingestion/health.py) ------------------
# The ingestion container turns unhealthy when the newest bronze insert is older than N seconds.
INGESTION_HEALTH_MAX_AGE_S=15

# -- Gold refresh loop (src/data/refresh, Phase 4) ---------------------------------
# Seconds between refresh cycles.
REFRESH_INTERVAL_S=5
# Reference-time clock: `data` = newest bus-report event time (simulator demo);
# `wall` = current UTC time (real telemetry). The code default when unset is `wall`.
REFRESH_CLOCK=data
# Healthcheck of the refresh service: unhealthy when no gold snapshot was committed in the
# last N seconds of wall-clock time (default 30). In `data` mode a whole-feed stop also
# stops new snapshots, so the service turns unhealthy (declared M3 limitation).
REFRESH_HEALTH_MAX_AGE_S=30

# -- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
