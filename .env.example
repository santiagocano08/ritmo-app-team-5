# .env.example — committed; copy to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
#
# PulsoFlota — Turn-1 environment variables
# All values here are safe, non-secret defaults for local development.
# In any real environment, replace POSTGRES_PASSWORD with a strong secret
# injected at runtime (Docker Secrets or Vault — deferred to turn 2).

# -- PostgreSQL credentials -------------------------------------------------
POSTGRES_DB=pulsoflota
POSTGRES_USER=pulsoflota
# REQUIRED. The compose stack refuses to start if this is not set.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# -- Application DSN (read by src/pulsoflota/config.py) ---------------------
# 'db' is the docker-compose service name; use 'localhost' for local runs.
DATABASE_URL=postgresql://pulsoflota:change_me@db:5432/pulsoflota

# -- API service port -------------------------------------------------------
API_PORT=8000

# -- Simulator settings (read by src/data/simulator/main.py) --------------------
SIM_SEED=42
SIM_DURATION_S=3600
# Wall-clock seconds per simulated 5-s step (1 = 5x faster than real time; 0 = as fast as possible)
SIM_PACE_S=1
# Planned headway in seconds (R14). Buses start this far apart; one bus cycle is
# (in-service buses x this value). Must equal config.corridor_settings.headway_planned_s.
SIM_PLANNED_HEADWAY_S=600
# Scenario injectors (feature 004). Both are optional; empty means no scenario and the base stream.
# Path of a JSON scenario file (C1 bunching, C2 gap, C5 breakdown, D1 silence/duplicates).
# Example: src/data/tests/fixtures/scenarios/c5_demo.json. An invalid file stops the simulator before
# the first event.
SIM_SCENARIO_FILE=
# Where the hidden scenario truth (JSON lines) is written at the end of the run; empty = stderr
# (the container log). The pipeline never reads it.
SIM_TRUTH_PATH=
# Hold loop (feature 004, Phase 2). `on` makes the simulator read approved holds from bronze (read-only)
# and execute them at the stop; `off` (default) never touches the database from the simulator.
SIM_HOLDS=off
# Seconds between polls of the approved decisions (wall time).
SIM_HOLD_POLL_S=1
# Probability that a driver does not comply with an approved hold, between 0 and 1 (seeded draw).
SIM_HOLD_NONCOMPLIANCE=0.10
# Demo demand (feature 006): multiplies the riders the simulator creates. 1.0 is the reference demand; accepted
# 0.1 to 10, anything else stops the simulator before the first event. Only the simulator reads it; the model
# sees the extra riders as observed arrivals and queues. The demo runs C1 with 3.
SIM_DEMAND_SCALE=1.0

# -- Ingestion retry on a database outage (src/data/ingestion/retry.py) ------------
# Seconds to wait after the first failure; the wait doubles each attempt.
INGESTION_RETRY_INITIAL_S=1
# Cap of the wait between two attempts.
INGESTION_RETRY_MAX_WAIT_S=5
# Total retry window per outage; when it ends ingestion logs db_retry_exhausted and exits non-zero.
INGESTION_RETRY_TOTAL_S=120

# -- Ingestion freshness healthcheck (src/data/ingestion/health.py) ------------------
# The ingestion container turns unhealthy when the newest bronze insert is older than N seconds.
INGESTION_HEALTH_MAX_AGE_S=15

# -- Decision model (feature 006, src/data/pipeline/recommend.py) ------------------
# `on` (default): every refresh cycle evaluates the action catalog and publishes up to 3 recommendations.
# `off`: no candidates and no new recommendation; existing ones still get their derived status.
MPC_ENABLED=on

# -- Gold refresh loop (src/data/refresh, Phase 4) ---------------------------------
# Seconds between refresh cycles.
REFRESH_INTERVAL_S=5
# Reference-time clock: `data` = newest bus-report event time (simulator demo);
# `wall` = current UTC time (real telemetry). The code default when unset is `wall`.
REFRESH_CLOCK=data
# Healthcheck of the refresh service: unhealthy when no gold snapshot was committed in the
# last N seconds of wall-clock time (default 30). In `data` mode a whole-feed stop also
# stops new snapshots, so the service turns unhealthy (declared M3 limitation).
REFRESH_HEALTH_MAX_AGE_S=30

# -- Dispatcher console / frontend (src/frontend) ---------------------------
# Host port the console (Nginx reverse proxy) is published on. Open the console
# at http://localhost:${FRONTEND_PORT}.
FRONTEND_PORT=8080
# Console API base. The console reaches the backend through the SAME origin: the
# frontend proxy forwards the relative path /api/v1 to the api service, so no
# CORS config is needed. Leave VITE_API_BASE_URL UNSET to use the relative
# default (/api/v1). Set it ONLY for a non-default topology (separate origin).
# This is a build-time Vite variable; it is not a secret.
# VITE_API_BASE_URL=

# -- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
